PROJECT_NAME           = "rc_agent"
PROJECT_BRIEF          = "RC API v2 C++ API reference"
OUTPUT_DIRECTORY      = docs/_build
INPUT                 = source
RECURSIVE             = YES
FILE_PATTERNS         = *.h *.hpp *.hh *.cpp *.cc *.c *.proto
EXCLUDE_PATTERNS      = */.git/* */build/* */build-*/* */tests/* */test/* */third_party/*
EXTRACT_ALL           = YES
EXTRACT_PRIVATE       = NO
EXTRACT_STATIC        = NO
HIDE_UNDOC_MEMBERS    = NO
WARN_IF_UNDOCUMENTED  = NO
QUIET                 = YES
GENERATE_HTML         = YES
HTML_OUTPUT           = doxygen
HTML_DYNAMIC_SECTIONS = YES
SOURCE_BROWSER        = YES
GENERATE_XML          = YES
XML_OUTPUT            = xml
GENERATE_LATEX        = NO
HAVE_DOT              = YES
DOT_IMAGE_FORMAT      = svg
INTERACTIVE_SVG       = YES
CALL_GRAPH            = NO
CALLER_GRAPH          = NO
UML_LOOK              = NO
